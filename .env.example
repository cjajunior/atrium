# Public values, safe to ship to the browser. When empty, src/lib/config.ts points to the demo project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Used for billing: saving the Stripe customer and applying webhook events.
SUPABASE_SECRET_KEY=

# Stripe, test mode only.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional. The public URL of the deployment, used in Stripe and email links.
NEXT_PUBLIC_SITE_URL=
